<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.abajin.innovation.mapper.TicketTypeMapper">
    <resultMap id="BaseResultMap" type="com.abajin.innovation.entity.TicketType">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM ticket_type ORDER BY id ASC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM ticket_type WHERE id = #{id}
    </select>

    <select id="selectByName" resultMap="BaseResultMap">
        SELECT * FROM ticket_type WHERE name = #{name}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ticket_type (name, description, create_time, update_time)
        VALUES (#{name}, #{description}, #{createTime}, #{updateTime})
    </insert>

    <update id="update">
        UPDATE ticket_type
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="description != null">description = #{description},</if>
            update_time = #{updateTime}
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM ticket_type WHERE id = #{id}
    </delete>

    <select id="countTicketsByTypeId" resultType="int">
        SELECT COUNT(*) FROM ticket WHERE type_id = #{typeId} AND is_deleted = 0
    </select>
</mapper>
